# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (secrets).

# --- AWS ---
aws_region  = "us-east-1"
aws_profile = ""  # e.g. "my-sso-profile"; empty = default credential chain

# --- Access for first-time setup (pick ONE approach) ---
# Option A: RDP. Set your current public IP as a /32 and an existing key pair
#           (needed to decrypt the Windows Administrator password).
allowed_rdp_cidr = "" # e.g. "203.0.113.7/32"  — find yours: curl ifconfig.me
key_pair_name    = "" # e.g. "windrose-admin"  — must already exist in EC2

# Option B: leave both empty and administer via SSM Fleet Manager (no open ports).

# --- Discord (from the Discord Developer Portal) ---
discord_public_key     = "REPLACE_ME" # App -> General Information -> Public Key
discord_application_id = "REPLACE_ME" # App -> General Information -> Application ID
discord_guild_id       = "REPLACE_ME" # Your Discord server ID (enable Developer Mode, right-click server)
discord_bot_token      = "REPLACE_ME" # App -> Bot -> Token (sensitive)
discord_webhook_url    = "REPLACE_ME" # Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL (sensitive)

# --- Optional tuning ---
# instance_type               = "t3.xlarge"
# root_volume_gb              = 50
# custom_ami_id               = ""   # set to your captured AMI after first install
# idle_grace_minutes          = 15
# empty_on_boot_grace_minutes = 20
# open_game_port              = false
# game_port                   = 7777

# --- Optional: Venmo tip QR shown on /start, /stop, and idle shutdown ---
# Set your Venmo link AND drop your QR image at assets/venmo-qr.png. Empty = off.
# venmo_tip_url = "https://venmo.com/u/your-handle"
